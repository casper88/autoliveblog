# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Optional: OpenAI as a fallback engine (used automatically when Gemini is throttled)
# OPENAI_API_KEY=sk-...

# Optional: Telegram bot (token from @BotFather; chat_id accepts a comma-separated list)
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=your-chat-id

# Everything below is optional.

# Interface language: en (default) or zh-TW.
# This also picks the default summary language, so setting it is usually enough.
# AUTOLIVEBLOG_UI_LANG=en

# Language the AI writes summaries in. Defaults to English, or 繁體中文 when
# AUTOLIVEBLOG_UI_LANG is a Chinese locale. Set this only if you want the
# interface in one language and the summaries in another.
# AUTOLIVEBLOG_LANG=English

# AUTOLIVEBLOG_PROVIDER=auto        # auto / gemini / openai
# AUTOLIVEBLOG_MODEL=gemini-3.5-flash-lite
# AUTOLIVEBLOG_OPENAI_MODEL=gpt-4o-mini
# AUTOLIVEBLOG_OPENAI_STT_MODEL=gpt-4o-mini-transcribe
# AUTOLIVEBLOG_CHUNK_SECONDS=180
# AUTOLIVEBLOG_OUTPUT_DIR=summaries
