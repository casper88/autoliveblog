# 到 https://aistudio.google.com/apikey 免費申請
GEMINI_API_KEY=你的金鑰

# 選填:OpenAI 備援引擎(Gemini 額度耗盡時自動切換)
# OPENAI_API_KEY=sk-...

# 選填:Telegram 機器人(@BotFather 申請 token;chat_id 可多個逗號分隔)
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=你的chat_id

# 以下皆為選填
# AUTOLIVEBLOG_PROVIDER=auto        # auto / gemini / openai
# AUTOLIVEBLOG_MODEL=gemini-2.5-flash
# AUTOLIVEBLOG_OPENAI_MODEL=gpt-4o-mini
# AUTOLIVEBLOG_OPENAI_STT_MODEL=gpt-4o-mini-transcribe
# AUTOLIVEBLOG_LANG=繁體中文
# AUTOLIVEBLOG_CHUNK_SECONDS=180
# AUTOLIVEBLOG_OUTPUT_DIR=summaries
